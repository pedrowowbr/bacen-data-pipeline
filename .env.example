# Copie este arquivo para .env antes de subir o docker-compose

# UID do seu usuário local (evita problemas de permissão nos volumes do Airflow no Linux/WSL)
# Windows/Docker Desktop pode manter 50000
AIRFLOW_UID=50000

# Postgres (compartilhado por Airflow metadata e pelos dados do pipeline)
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme123
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Banco usado pelo metadata do Airflow
AIRFLOW_DB=airflow

# Banco usado pelos dados do pipeline (raw / staging / marts)
BACEN_DB=bacen

# Admin criado no primeiro start do Airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=changeme123
AIRFLOW_ADMIN_FIRSTNAME=Admin
AIRFLOW_ADMIN_LASTNAME=Admin
AIRFLOW_ADMIN_EMAIL=admin@example.com
